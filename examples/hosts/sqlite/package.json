{
  "name": "@openwop/openwop-host-sqlite",
  "version": "2.0.0",
  "private": true,
  "description": "SQLite-backed OpenWOP v2 host: durable runs in one file, claim-based dispatch, and a v1-to-v2 porting walkthrough. Reuses the v2 reference host's contract modules.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx test/durability.test.ts",
    "conformance": "openwop-conformance --target-major 2"
  },
  "dependencies": {
    "@openwop/spec-artifacts": "2.49.14",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@openwop/openwop-conformance": "2.49.14",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
