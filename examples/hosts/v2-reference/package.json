{
  "name": "@openwop/openwop-host-v2-reference",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "Reference OpenWOP v2 host — the charter §F witness. Implemented from spec/v2/core/*.md and the generated v2 documents; node:http + better-sqlite3 + node:crypto, no framework.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir test",
    "conformance": "openwop-conformance --target-major 2 --require-behavior",
    "keygen": "node scripts/keygen.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@openwop/openwop-conformance": "2.0.0-rc.59",
    "@openwop/spec-artifacts": "2.0.0-rc.59",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
