{
  "name": "@openwop/openwop-host-postgres",
  "version": "2.0.0",
  "private": true,
  "description": "Postgres-backed OpenWOP v2 host: durable runs shared by several processes, claims held as session-level advisory locks, and a hash-chained, checkpointed audit log. Runs against a real Postgres (OPENWOP_PG_DSN) or in-process PGlite. Reuses the v2 reference host's contract modules.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:pglite": "OPENWOP_PG_DSN= tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx test/durability.test.ts && tsx test/audit-tamper.test.ts",
    "test:siblings": "tsx test/audit-checkpoint-export.test.ts && tsx test/pack-consumer.test.ts",
    "conformance": "openwop-conformance --target-major 2"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@openwop/spec-artifacts": "2.49.15",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@openwop/openwop-conformance": "2.49.15",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
