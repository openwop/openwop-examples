{
  "//": "The tests carried over from the v1 host (audit-checkpoint-export, pack-consumer) are left as they were cited, and run, not typechecked.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/durability.test.ts",
    "test/audit-tamper.test.ts"
  ]
}
